# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# database backups written by the admin backup tool
/backup

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# large NYSED source data — do not commit (multi-GB Access DBs)
/sampledata

# python ingestion toolkit
ingest/.venv/
ingest/_work/
ingest/_extracted/
**/__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# machine-specific Claude Code settings
.claude/settings.local.json
