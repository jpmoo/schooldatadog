# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed as the template.

# PostgreSQL connection string used by both the app and drizzle-kit migrations.
# Local example:
#   postgres://USER:PASSWORD@localhost:5432/schooldatadog
# Home-server example (over the network):
#   postgres://USER:PASSWORD@192.168.1.50:5432/schooldatadog
DATABASE_URL="postgres://user:password@localhost:5432/schooldatadog"

# Sub-path to serve the app under when reverse-proxied at https://<host>/schooldatadog.
# Read at BUILD time (baked into the bundle) — set it before `npm run build`.
# Leave unset/blank to serve at the root (local dev). With this set, do NOT strip
# the prefix in Caddy — Next emits /schooldatadog/... links and asset URLs.
# BASE_PATH="/schooldatadog"

# Port the Node server listens on. NOTE: `next start` reads this from the real
# process environment, NOT from this .env file. Set it where the app runs — e.g.
# a systemd unit (Environment=PORT=8935) or `PORT=8935 npm start`.
# PORT=8935
